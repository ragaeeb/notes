    },
    "dependencies": {
        "@lexical/code": "^0.52.0",
        "@lexical/link": "^0.52.0",
        "@lexical/list": "^0.52.0",
        "@lexical/markdown": "^0.52.0",
        "@lexical/react": "^0.52.0",
        "@lexical/rich-text": "^0.52.0",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@tailwindcss/vite": "^4.3.3",
        "brotli-wasm": "^3.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lexical": "^0.52.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3"
    },
    "description": "Zero-backend document sharing app. The URL is the document.",
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.14.5",
        "@playwright/test": "^1.63.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "happy-dom": "^20.14.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.1"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=26.0.0"
    },
    "homepage": "https://notes.ilmtest.io",
    "keywords": [
        "notes",
        "url",
        "sharing",
        "serverless",
        "brotli",
        "lexical"
    ],
    "license": "MIT",
    "name": "notes",
    "overrides": {
        "vite": "^8.0.0-beta.13"
    },
    "packageManager": "bun@1.4.2",
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/ragaeeb/notes"
    },
    "scripts": {
        "build": "tsc && vite build",
        "compression:benchmark": "bun scripts/compression/benchmark.ts",
        "compression:fixtures": "bun scripts/compression/export-fixtures.ts",
        "compression:qualify": "VITE_ENABLE_V2=true VITE_ENABLE_CM_EXPERIMENTAL=true ALL_BROWSERS=true RUN_E2E=true playwright test",
        "compression:verify": "bun scripts/compression/verify-wire.ts",
        "dev": "vite",
        "format": "bunx biome format --write src",
        "lint": "bunx biome check src",
        "lint:fix": "bunx biome check --write src",
        "preview": "vite preview",
        "test": "bun test src",
        "test:e2e": "RUN_E2E=true playwright test"
    },
    "type": "module",
    "version": "1.1.0"
}
